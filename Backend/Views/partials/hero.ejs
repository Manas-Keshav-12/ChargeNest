<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>home</title>
    <link rel="stylesheet" href="/CSS/hero.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
</head>
<body>
    <section class="hero">
        <div class="hero-container">
            <div class="hero-bg">
                <div class="shape shape-1"></div>
                <div class="shape shape-2"></div>
                <div class="shape shape-3"></div>
            </div>
            <!-- Left Content -->
            <div class="hero-left">
                <span class="hero-badge">
                    ⚡ Smart EV Charging for Apartments
                </span>
                <h1 class="hero-title">
                    Book Your EV Charging Slot
                    Before You Reach Home
                </h1>
                <p class="hero-description">
                    ChargeNest helps apartment residents reserve charging stations,
                    check live charger availability, and receive real-time updates—
                    all from one simple platform.
                </p>
                <div class="hero-buttons">
                    <a href="/register" class="primary-btn">
                        Get Started
                    </a>
                    <a href="#demo" class="secondary-btn">
                        Watch Demo
                    </a>
                </div>
            </div>
            <!-- Right Content -->
            <div class="hero-right">
                 <img src="/Images/chargenest-hero.svg" alt="ChargeNest EV charging illustration">       
            </div>
        </div>
    </section>
</body>
</html>