<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact</title>
    <link rel="stylesheet" href="/CSS/contact.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
</head>
<body>
    <%- include("navbar") %>
    <section class="contact">
        <div class="contact-heading">
            <span class="section-badge">
                📞 Contact Us
            </span>
            <h1>
                Let's Build Smarter
                EV Charging Together
            </h1>
            <p>
                Whether you're managing a residential community,
                planning a new apartment project, or simply want to
                learn more about ChargeNest, we'd love to hear from you.
            </p>
        </div>
        <div class="contact-container">
            <!-- Contact Form -->
            <div class="contact-form">
                <h2>Send us a Message</h2>
                <form>
                    <input type="text" placeholder="Full Name">
                    <input type="email" placeholder="Email Address">
                    <input type="text" placeholder="Apartment / Company">
                    <input type="text" placeholder="Subject">
                    <textarea
                        rows="6"
                        placeholder="Tell us about your project or enquiry..."
                    ></textarea>
                    <button type="submit">
                        Send Message
                    </button>
                </form>
            </div>
            <!-- Contact Information -->
            <div class="contact-info">
                <h2>Contact Information</h2>
                <div class="info-card">
                    <h3>📧 Email</h3>
                    <p>support@chargenest.com</p>
                </div>
                <div class="info-card">
                    <h3>📞 Phone</h3>
                    <p>+91 98765 43210</p>
                </div>
                <div class="info-card">
                    <h3>📍 Office</h3>
                    <p>
                        Hyderabad, Telangana<br>
                        India
                    </p>
                </div>
                <div class="info-card">
                    <h3>🕒 Working Hours</h3>
                    <p>
                        Monday – Friday<br>
                        9:00 AM – 6:00 PM
                    </p>
                </div>
            </div>
        </div>
    </section>
    <%- include("footer") %>
</body>
</html>