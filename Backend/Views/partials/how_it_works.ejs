<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>How it Works</title>
    <link rel="stylesheet" href="/CSS/how_it_works.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
</head>
<body>
    <section class="how-it-works" id="how-it-works">
        <div class="how-container">
            <div class="how-heading">
                <div class="section-badge">
                    <span>⚡How It Works</span>
                </div>
                <h2>Start Charging in Three Simple Steps</h2>
                <p>
                    Reserve your charging slot, power up your EV, and manage everything
                    from one seamless platform designed for apartment communities.
                </p>
            </div>
            <div class="steps-grid">
                <!-- Step 1 -->
                <div class="step-card">
                    <!-- <span class="step-number">03</span> -->
                    <div class="step-icon">
                        <!-- Calendar SVG -->
                    </div>
                    <h3> <span class="step-number">01</span> Reserve Your Charging Slot</h3>
                    <p>
                        View real-time charger availability and book a convenient
                        time slot before you arrive home.
                    </p>
                </div>
                <!-- Step 2 -->
                <div class="step-card">
                    <!-- <span class="step-number">03</span> -->
                    <div class="step-icon">
                        <!-- Charging SVG -->
                    </div>
                    <h3> <span class="step-number">02</span> Plug In & Start Charging</h3>
                    <p>
                        Park your EV, connect the charger, and begin charging instantly
                        with live session tracking.
                    </p>

                </div>
                <!-- Step 3 -->
                <div class="step-card">
                    <!-- <span class="step-number">03</span> -->
                    <div class="step-icon">
                        <!-- Analytics / Payment SVG -->
                    </div>
                    <h3> <span class="step-number">03</span> Track Usage & Pay Securely</h3>
                    <p>
                        Monitor charging history, energy consumption, and complete
                        secure cashless payments directly through the dashboard.
                    </p>
                </div>
            </div>
        </div>
    </section>
</body>
</html>